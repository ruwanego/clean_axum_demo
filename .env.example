# Copy to `.env` for local development: cp .env.example .env
# `.env` is only read by `cargo run` for convenience. In any deployed environment,
# set these as real environment variables (never bake a .env file into an image).

# DATABASE
DATABASE_URL=postgres://testuser:pass@localhost:5432/testdb
DATABASE_MAX_CONNECTIONS=5
DATABASE_MIN_CONNECTIONS=1
# Connection attempts at startup (exponential backoff) and pool acquire timeout
DATABASE_CONNECT_RETRIES=5
DATABASE_ACQUIRE_TIMEOUT_SECS=5
# Apply migrations when the server starts (convenient locally; prefer `clean_axum_demo migrate` in prod)
RUN_MIGRATIONS_ON_START=true

# Web Service
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080
REQUEST_TIMEOUT_SECS=1800
# Comma-separated list of allowed origins, or * for any
CORS_ALLOWED_ORIGINS=*

# Logging
# RUST_LOG format: crate1=level1,crate2=level2,...
# - sqlx=debug  → shows SQL statements and connection info
# - tower_http=info → middleware-level logs
# - axum::rejection=trace → logs full details for Axum rejections (like validation errors)
# - request/response bodies are logged at debug level only
RUST_LOG=info,sqlx=info,tower_http=info,axum::rejection=trace,opentelemetry=info
# pretty (default) or json
LOG_FORMAT=pretty

# JWT
# Generate with: openssl rand -base64 32   (min 32 characters)
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-base64-32
JWT_EXPIRY_SECS=86400

# Asset Config
ASSETS_PUBLIC_PATH=assets/public
ASSETS_PUBLIC_URL=/assets/public
ASSETS_PRIVATE_PATH=assets/private
ASSETS_PRIVATE_URL=/assets/private

# 50MB: 50 * 1024 * 1024 = 52428800
ASSET_MAX_SIZE=52428800
ASSET_ALLOWED_EXTENSIONS=jpg|jpeg|png|gif|webp|svg|mp4|mov|avi|wmv|flv|mkv|mp3|wav|ogg|opus|pdf|doc|docx|ppt|pptx|xls|xlsx|hwp|hwpx|txt|zip

# OpenTelemetry OTLP Exporter (only with `--features opentelemetry`)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# docker compose only: credentials for the bundled Postgres container
POSTGRES_USER=testuser
POSTGRES_PASSWORD=pass
POSTGRES_DB=testdb
